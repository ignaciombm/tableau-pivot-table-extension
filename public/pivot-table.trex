<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.fever.extensions.pivot-table" extension-version="0.9.2">
    <default-locale>en_US</default-locale>
    <name resource-id="name" />
    <description>Configurable pivot table viz extension with collapsible row/column groups, sortable columns (including Grand Total), resizable row headers, period-over-period and heatmap coloring, and per-measure number formatting. Drop dimensions onto Rows/Columns and measures onto Measures; click Format Extension on the Marks card for creator settings.</description>
    <author name="Fever Data Team" email="ignacio.martin@feverup.com" organization="Fever" website="https://feverup.com" />
    <min-api-version>1.12</min-api-version>
    <source-location>
      <url>https://ignaciombm.github.io/tableau-pivot-table-extension/index.html</url>
    </source-location>
    <icon>iVBORw0KGgoAAAANSUhEUgAAAEAAAABACAYAAACqaXHeAAAAF0lEQVR4nGNgGAWjYBSMglEwCkbBSAcACBAAAdOMhWQAAAAASUVORK5CYII=</icon>
    <permissions>
      <permission>full data</permission>
    </permissions>
    <context-menu>
      <configure-context-menu-item />
    </context-menu>
    <encoding id="rows">
      <display-name resource-id="encoding-rows" />
      <fields max-count="4" />
      <tooltip>Dimensions to nest down the rows of the pivot table, outermost first.</tooltip>
    </encoding>
    <encoding id="columns">
      <display-name resource-id="encoding-columns" />
      <fields max-count="4" />
      <tooltip>Dimensions to nest across the columns of the pivot table, outermost first.</tooltip>
    </encoding>
    <encoding id="measures">
      <display-name resource-id="encoding-measures" />
      <fields max-count="4" />
      <tooltip>Measures to display as values in the pivot table, with whatever aggregation they carry.</tooltip>
    </encoding>
  </worksheet-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Pivot Table</text>
    </resource>
    <resource id="encoding-rows">
      <text locale="en_US">Rows</text>
    </resource>
    <resource id="encoding-columns">
      <text locale="en_US">Columns</text>
    </resource>
    <resource id="encoding-measures">
      <text locale="en_US">Measures</text>
    </resource>
  </resources>
</manifest>
